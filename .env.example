# Google Gemini API key (https://aistudio.google.com/apikey). Server-side only; never exposed to the browser.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.5-flash)
GEMINI_MODEL=

# Optional: Upstash Redis REST credentials for a global rate limit shared by every serverless instance.
# The Vercel Marketplace Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
# Without them, each instance falls back to its own in-memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
